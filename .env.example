# Docker 部署推荐使用文件型密钥，避免密钥值出现在 docker inspect 中。
# 文件内可以放一个 Key，或以逗号分隔放多个客户端网关 Key。
CLIENT_API_KEYS_FILE=/run/secrets/gateway_api_key
ADMIN_API_KEY_FILE=/run/secrets/admin_api_key
ALIYUN_API_KEY_1_FILE=/run/secrets/aliyun_api_key_1
ALIYUN_API_KEY_2_FILE=/run/secrets/aliyun_api_key_2

# 非 Docker 本地开发仍可直接设置 GATEWAY_API_KEY、ADMIN_API_KEY、
# ALIYUN_API_KEY_1、ALIYUN_API_KEY_2，但生产环境不推荐。

# 方案 B：也可直接用逗号列表覆盖 config.json 的 upstream 列表。
# ALIYUN_API_KEYS=sk-key-1,sk-key-2,sk-key-3

# 可选覆盖项：逗号分隔，每位用户建议分配一个不同的网关 Key。
# CLIENT_API_KEYS=sk-user-a-replace-with-random-value,sk-user-b-replace-with-random-value
# 旧公共地址（当前项目默认值）
# OPENAI_UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ANTHROPIC_UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
# 如需切回业务空间专属地址，改用：
# OPENAI_UPSTREAM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ANTHROPIC_UPSTREAM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/apps/anthropic
# BALANCER_STRATEGY=least_inflight
# MAX_ATTEMPTS=3
# 当前 2 Key 服务器的实测安全起点：总并发 10、每 Key 5。
# 增加 Key 后再按实测逐步提高总并发。
# MAX_CONCURRENT_REQUESTS=10
# MAX_CONCURRENT_PER_UPSTREAM=5
# LISTEN_ADDR=:8080
